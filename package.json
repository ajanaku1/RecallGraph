{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test:core": "npm run typecheck && node --test tests/core/*.test.ts",
    "test:function-checker": "node --test tests/scripts/check-function-length.test.ts",
    "test:submission": "node --test tests/submission/submission-contract.test.ts",
    "test:video": "node --test tests/video/*.test.ts",
    "verify:fixture": "node --test tests/catalog/*.test.ts && node scripts/verify_fixture.mjs",
    "seed:live-gate": "sh scripts/run_datahub_python.sh scripts/seed_live_gate.py",
    "test:live-gate": "sh scripts/run_datahub_python.sh tests/test_live_gate.py",
    "verify:live-gate": "sh scripts/run_datahub_python.sh scripts/verify_live_gate.py",
    "test:ui": "vitest run tests/app",
    "test:e2e:fixture": "vitest run tests/app",
    "verify:a11y": "vitest run tests/app/accessibility.test.tsx",
    "test": "npm run test:core && npm run test:function-checker && npm run test:submission && npm run test:video && npm run verify:fixture && npm run test:ui && python3 -m unittest tests/test_live_gate_rollback.py tests/test_verify_live_gate_integration.py",
    "verify:submission": "node scripts/verify_submission.mjs",
    "build": "next build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "next": "^16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
