{
  "name": "recallgraph-demo-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "compositions": "remotion compositions src/Root.tsx",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/Root.tsx Main out/demo.mp4 --concurrency 4",
    "render:social": "remotion render src/Root.tsx Social out/hook-social.mp4 --concurrency 4",
    "render:all": "npm run render && npm run render:social"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.507",
    "@remotion/cli": "^4.0.507",
    "@remotion/google-fonts": "^4.0.507",
    "@remotion/media": "^4.0.507",
    "@remotion/transitions": "^4.0.507",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.507"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^6.0.3"
  }
}
